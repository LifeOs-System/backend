{
  "openapi": "3.1.1",
  "info": {
    "title": "Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7017"
    },
    {
      "url": "http://localhost:5068"
    }
  ],
  "paths": {
    "/api/habits": {
      "post": {
        "tags": [
          "Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHabitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Area": {
        "type": "integer"
      },
      "CreateHabitRequest": {
        "required": [
          "name",
          "area"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/HabitType"
          },
          "target": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOfWeek"
            }
          }
        }
      },
      "DayOfWeek": {
        "type": "integer"
      },
      "HabitType": {
        "type": "integer"
      }
    }
  },
  "tags": [
    {
      "name": "Api"
    }
  ]
}